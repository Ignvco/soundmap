# Credenciales de firma para el build de release.
#
# Copiar a `android/keystore.properties` y completar. Ese archivo está en
# .gitignore — NUNCA lo subas al repo.
#
# En CI, en vez de este archivo usá las variables de entorno:
#   SOUNDMAP_STORE_PASSWORD, SOUNDMAP_KEY_ALIAS, SOUNDMAP_KEY_PASSWORD

storePassword=
keyAlias=
keyPassword=
